POSTGRES_PORT=5432

# -----------------------------
# RabbitMQ
# -----------------------------
RABBITMQ_DEFAULT_USER=relay
RABBITMQ_DEFAULT_PASS=relay_dev_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# -----------------------------
# ChromaDB
# -----------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# -----------------------------
# AI / external services
