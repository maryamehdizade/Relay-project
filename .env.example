# -----------------------------
# Django
# -----------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# -----------------------------
# PostgreSQL
# -----------------------------
POSTGRES_DB=relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay_dev_password
